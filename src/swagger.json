{
    "openapi": "3.0.0",
    "info": {
        "title": "TechFlow API - Documentação",
        "description": "API do sistema TechFlow para gerenciamento de assistência técnica e produtos.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Servidor Local de Desenvolvimento"
        }
    ],
    "paths": {
        "/usuarios": {
            "post": {
                "tags": ["Usuários"],
                "summary": "Cadastro de novos usuários",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "nome": { "type": "string", "example": "João Silva" },
                                    "email": { "type": "string", "example": "joao@email.com" },
                                    "senha": { "type": "string", "example": "123456" },
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Usuário criado com sucesso" },
                    "400": { "description": "Dados inválidos ou e-mail já cadastrado" }
                }
            }
        },
        "/login": {
            "post": {
                "tags": ["Autenticação"],
                "summary": "Autenticação de usuário",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": { "type": "string", "example": "joao@email.com" },
                                    "senha": { "type": "string", "example": "123456" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Login efetuado com sucesso (Retorna o Token JWT)" },
                    "400": { "description": "E-mail ou senha incorretos" }
                }
            }
        },
        "/produtos": {
            "post": {
                "tags": ["Produtos"],
                "summary": "Cadastra um ou vários produtos em lote na loja",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "nome": { "type": "string", "example": "Tela iPhone 11" },
                                        "descricao": { "type": "string", "example": "Tela iPhone 11 Display Lcd" },
                                        "preco": { "type": "number", "example": 79.00 },
                                        "categoria": { "type": "string", "example": "peças para celulares" },
                                        "imagemUrl": { "type": "string", "example": "https://link-da-imagem.com/foto.jpg" }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Produtos cadastrados com sucesso" }
                }
            },
            "get": {
                "tags": ["Produtos"],
                "summary": "Lista todos os produtos cadastrados",
                "responses": {
                    "200": { "description": "Lista de produtos retornada com sucesso" }
                }
            }
        },
        "/ordens": {
            "post": {
                "tags": ["Ordens de Serviço"],
                "summary": "Cria uma nova Ordem de Serviço",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "clienteNome": { "type": "string", "example": "Carlos Oliveira" },
                                    "equipamento": { "type": "string", "example": "Notebook Dell Inspiron" },
                                    "defeito": { "type": "string", "example": "Não liga e liga cooler rápido" },
                                    "valor": { "type": "number", "example": 250.00 },
                                    "tecnicoId": { "type": "string", "example": "id-do-tecnico-aqui" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Ordem de serviço criada com sucesso" }
                }
            },
            "get": {
                "tags": ["Ordens de Serviço"],
                "summary": "Lista todas as Ordens de Serviço",
                "responses": {
                    "200": { "description": "Lista de OS retornada com sucesso" }
                }
            }
        }
    }
}